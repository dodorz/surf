[Output]
; Target language for translation (e.g., zh-cn, en, etc.)
target_language = zh-cn
; On Windows, Surf accepts '~/Note' style paths here and maps '~' to %USERPROFILE%.
; Directory to save Markdown notes
md_dir = ./notes
; Directory to save PDF files (default: current directory)
pdf_dir = ./pdf
; PDF rendering engine chain, tried in order until one produces a PDF.
; auto = playwright, chrome, weasyprint
; Values: auto, playwright, chrome (chromium), weasyprint; combine with commas
;   e.g. pdf_engine = weasyprint,chrome
; playwright needs `uv sync --extra browser` + `uv run playwright install chromium`;
; chrome uses a local Chrome/Chromium/Edge binary (see [Browser] chrome_executable);
; weasyprint needs `uv sync --extra pdf` and needs no browser at all.
pdf_engine = auto
; Directory to save Audio files (default: current directory)
audio_dir = ./auido
; Directory to save HTML files (default: current directory)
html_dir = ./web
; Save the final source URL to the Internet Archive by default
; (CLI --archive and the Web UI checkbox can force it on per run)
archive = false
; Disable YAML front matter in markdown output by default
; (CLI --no-front-matter and the Web UI checkbox can force it on per run)
no_front_matter = false
; Inline CSS/JS in HTML output by default
; (CLI --html-inline and the Web UI checkbox can force it on per run)
html_inline = false

[Content]
; Content extractor: auto (readability then trafilatura fallback), readability, trafilatura, raw
; CLI -e/--extractor / -R / -T / -U and the Web UI extractor option override this per run.
extractor = auto

[Search]
; Keywords -> search engine -> interactive pick -> fetch/convert/save (CLI -S/--search).
; Engine: auto (DuckDuckGo, Bing, then configured SearXNG/Metaso), duckduckgo, bing, searxng, metaso
engine = auto
; Number of search results to retrieve per run (1-20)
limit = 5
; Interactive picker size when --search-preview is not given
preview = 5
; SearXNG instance base URL; the JSON API must be enabled on that instance
searxng_url =
; Metaso API key from https://metaso.cn (open API)
metaso_api_key =

[LLM]
; Default LLM provider name
provider = LLM1

[LLM.LLM1]
; OpenAI-compatible API configuration for L1
base_url = https://api.openai.com/v1
api_key = your_api_key_here
model = gpt-3.5-turbo

[LLM.LLM2]
; Additional LLM provider example (DeepSeek)
base_url = https://api.deepseek.com/v1
api_key = your_deepseek_api_key
model = deepseek-chat

[TTS]
; Support: edge-tts
engine = edge-tts
; Voice example: zh-CN-XiaoxiaoNeural, zh-CN-YunxiNeural, en-US-AriaNeural
; CLI override: --tts-voice; Web UI: TTS voice selector
voice = zh-CN-XiaoxiaoNeural
; Rate: +0%, +10%, -10%
; CLI override: --tts-rate; Web UI: rate input
rate = +0%
; Volume: +0%, +10%, -10%
; CLI override: --tts-volume; Web UI: volume input
volume = +0%

[Transcription]
; Local backend: transcribe.cpp (install with `uv sync --extra transcribe`)
backend = auto
; Path to a transcribe.cpp GGUF model, e.g. whisper-small-Q8_0.gguf
model_path =
; auto, zh, en, etc.
language = auto
; Transcript timestamp style: none = plain paragraphs (default), segment = [HH:MM:SS] prefix per line
; CLI override: --transcript-timestamps {none,segment}
timestamps = none
; ffmpeg executable or absolute path
ffmpeg_path = ffmpeg
; Maximum downloaded audio size in MB
max_audio_mb = 2048
; Audio connection read timeout in seconds
audio_timeout = 120

[Browser]
; Browser backend for dynamic pages: obscura (default) or playwright
; Override per run with CLI -B/--browser-backend {auto,obscura,playwright}
; or the Web UI "浏览器后端" option (auto = follow this setting).
; Playwright is an optional extra (`uv sync --extra browser`); it is required
; for interactive login, the special-site page handlers, the NCPSSD PDF
; download and the Playwright PDF engine only.
; Zhihu is an exception: its browser fallback always opens a visible
; Playwright window (the zse-ck challenge does not resolve headlessly),
; which needs a graphical session (DISPLAY) on Linux.
backend = obscura
; Obscura executable name or absolute path
obscura_executable = obscura
; Obscura CDP endpoint; Surf starts and reuses a managed server when unavailable
obscura_endpoint = http://127.0.0.1:9222
; How Surf talks to Obscura: auto (raw CDP, Playwright fallback on error),
; native (raw CDP only, no Playwright), playwright (legacy Playwright client)
; The generic headless fetch uses raw Chrome DevTools Protocol by default.
obscura_fetch = auto
; Build Obscura with anti-detection and tracker blocking enabled
obscura_stealth = false
; Seconds to wait for the Obscura CDP endpoint during startup
obscura_startup_timeout = 15
; Upper bound (seconds) for a single page navigation through Obscura.
; Keep it below the gunicorn worker timeout (recommended: --timeout 120).
obscura_navigation_timeout = 60
; Chrome/Chromium binary used by the Playwright-free PDF fallback.
; Leave empty to auto-detect (google-chrome, chromium, Edge, ...); the
; SURF_CHROME_EXECUTABLE environment variable takes precedence.
chrome_executable =
; Use curl-cffi TLS fingerprint impersonation to bypass Cloudflare challenges
; Requires: uv sync --extra curlcffi
; Values: false (default), true (always use), auto (use as fallback only)
curlcffi_mode = auto

[Network]
; Proxy mode: env (environment vars), win (Windows Internet Settings), custom (use custom_proxy), no (no proxy)
proxy_mode = env
; Custom proxy URL (e.g., http://127.0.0.1:7890)
custom_proxy =

[Cloudflare]
; Cloudflare cf_clearance cookies to bypass WAF hard blocks.
;
; How to extract:
;   1. Open Chrome, visit the target site, pass the Cloudflare challenge
;   2. Open DevTools (F12) > Application > Cookies > [domain]
;   3. Copy the cf_clearance cookie value
;   4. Add below as: domain = cf_clearance_value
;
; IMPORTANT: Cookies MUST come from Chrome (or Chromium-based browser),
; because curl-cffi impersonates Chrome 131's TLS fingerprint.
; Cookies from Firefox/Safari will NOT work.
;
; Format: DOMAIN = cookie_value
; Example: queue.acm.org = abc123def456...
; queue.acm.org =

[Twitter]
; Backend selection: cli (prefer uvx --from twitter-cli twitter), auto (CLI first, then native fallback), native (Surf built-in only)
backend = cli
; Deprecated and ignored: Surf always invokes `uvx --from twitter-cli twitter`
cli_bin =
; Optional browser hint for twitter-cli cookies: chrome, edge, brave, firefox, arc
browser =
; Optional browser profile hint for twitter-cli, for example: Default or Profile 2
profile =

[OCR]
; Enable OCR on article images by default (false by default; Xiaohongshu overrides to true)
enabled = false
; OCR engine: auto (default; paddleocr > rapidocr > tesseract), paddleocr, rapidocr, or tesseract
engine = auto
; Tesseract language(s), for example: chi_sim+eng, eng, jpn+eng
; Ignored by RapidOCR and PaddleOCR; used when Tesseract is selected or as fallback.
lang = chi_sim+eng
; Optional explicit path to the local tesseract executable
; On Windows, '~/Tools/tesseract.exe' also works and resolves under %USERPROFILE%.
tesseract_cmd =
; OCR at most this many images per article
max_images = 8
; Skip very small images
min_width = 240
min_height = 120
; Minimum OCR text length to keep
min_text_length = 8
; OCR engines run in a short-lived child process so their memory (PaddleOCR
; alone maps ~190 MB) is not retained by the web worker. Upper bound in seconds
; for one OCR batch; set 0 to disable the timeout.
worker_timeout = 900

[publish]
; Default publish target
target = pastebin

[publish.pastebin]
; Pastebin API key - get from https://pastebin.com/api/api-doc.html
; Register at https://pastebin.com/signup to get your API key
api_dev_key = your_pastebin_api_key_here
; Optional: Paste expiration (N, 10M, 1H, 1D, 1W, 1M, 1Y)
; api_paste_expire_date = N
; Optional: Paste privacy (0=public, 1=unlisted, 2=private)
; api_paste_private = 0
